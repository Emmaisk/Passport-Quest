function buildStreet() {
    clearEnv();
    scene.background = new THREE.Color(0x080916);
    scene.fog = new THREE.FogExp2(0x080916, 0.022);

    environmentGroup.add(new THREE.AmbientLight(0x33304d, 0.8));

    const road = new THREE.Mesh(
        new THREE.PlaneGeometry(22, 120),
        new THREE.MeshStandardMaterial({ color: 0x17171d, roughness: 0.95 })
    );
    road.rotation.x = -Math.PI / 2;
    road.position.z = -25;
    road.receiveShadow = true;
    environmentGroup.add(road);

    // Trottoirs
    for (const side of [-1, 1]) {
        const pavement = new THREE.Mesh(
            new THREE.BoxGeometry(3, 0.2, 110),
            new THREE.MeshStandardMaterial({ color: 0x383640 })
        );
        pavement.position.set(side * 12.5, 0.1, -25);
        environmentGroup.add(pavement);
    }

    // Pointillés au milieu de la route
    for (let i = 0; i < 16; i++) {
        const mark = new THREE.Mesh(
            new THREE.BoxGeometry(0.16, 0.025, 2),
            new THREE.MeshBasicMaterial({ color: 0xb8b6a5 })
        );
        mark.position.set(0, 0.025, 10 - i * 7);
        environmentGroup.add(mark);
    }

    // Bâtiments avec quelques fenêtres lumineuses
    for (let i = 0; i < 6; i++) {
        const z = 12 - i * 18;

        for (const side of [-1, 1]) {
            const building = new THREE.Mesh(
                new THREE.BoxGeometry(9, 16 + (i % 3) * 3, 15),
                new THREE.MeshStandardMaterial({ color: side < 0 ? 0x191723 : 0x20202c })
            );
            building.position.set(side * 17, 8 + (i % 3) * 1.5, z);
            environmentGroup.add(building);

            for (let w = 0; w < 3; w++) {
                const window = new THREE.Mesh(
                    new THREE.PlaneGeometry(1.1, 1.5),
                    new THREE.MeshBasicMaterial({
                        color: (i + w) % 2 === 0 ? 0xffc86b : 0x69baff
                    })
                );
                window.position.set(side * 12.4, 7 + w * 2.5, z + w * 2);
                window.rotation.y = side < 0 ? Math.PI / 2 : -Math.PI / 2;
                environmentGroup.add(window);
            }
        }
    }

    // Lampadaires colorés
    for (let i = 0; i < 6; i++) {
        const side = i % 2 === 0 ? -1 : 1;
        const z = 10 - i * 16;

        const pole = new THREE.Mesh(
            new THREE.CylinderGeometry(0.09, 0.14, 5.5),
            new THREE.MeshStandardMaterial({ color: 0x292a35, metalness: 0.6 })
        );
        pole.position.set(side * 8, 2.75, z);
        environmentGroup.add(pole);

        const lamp = new THREE.PointLight(
            i % 2 === 0 ? 0xffa64d : 0x8b75ff,
            2.2,
            20
        );
        lamp.position.set(side * 8, 5.5, z);
        environmentGroup.add(lamp);

        const glow = new THREE.Mesh(
            new THREE.SphereGeometry(0.25, 10, 10),
            new THREE.MeshBasicMaterial({
                color: i % 2 === 0 ? 0xffbd68 : 0xa18dff
            })
        );
        glow.position.copy(lamp.position);
        environmentGroup.add(glow);
    }

    // Soucoupe volante au fond de la rue
    const ufoGroup = new THREE.Group();

    const hull = new THREE.Mesh(
        new THREE.CylinderGeometry(3.5, 4.5, 1.3, 24),
        new THREE.MeshStandardMaterial({
            color: 0x71808c,
            metalness: 0.8,
            roughness: 0.25
        })
    );

    const dome = new THREE.Mesh(
        new THREE.SphereGeometry(2, 18, 14),
        new THREE.MeshStandardMaterial({
            color: 0x43ffb0,
            emissive: 0x116644,
            transparent: true,
            opacity: 0.85
        })
    );
    dome.position.y = 0.8;
    dome.scale.y = 0.55;

    const ufoLight = new THREE.PointLight(0x39ff9b, 3, 22);
    ufoLight.position.y = -1;

    ufoGroup.add(hull, dome, ufoLight);
    ufoGroup.position.set(0, 2, -60);
    environmentGroup.add(ufoGroup);

    interactables.push({
        mesh: hull,
        type: 'exit',
        hint: "Appuyez sur [E] pour embarquer dans la soucoupe"
    });

    player.position.set(0, playerHeight, 25);
    setUI("3. La rue", "#a58bff", "Courez jusqu'à votre soucoupe volante !");
}
